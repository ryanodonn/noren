NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google AI Studio key (aistudio.google.com/apikey) — free tier, no billing required.
GEMINI_API_KEY=
# Supabase dashboard → Project Settings → API Keys → reveal "service_role" secret.
# Bypasses RLS — only used server-side by the seed-generation cron (src/lib/supabase/service.ts).
SUPABASE_SERVICE_ROLE_KEY=
# Random secret Vercel Cron sends back as a Bearer token so the cron route
# can reject requests that aren't the real scheduled invocation.
CRON_SECRET=
